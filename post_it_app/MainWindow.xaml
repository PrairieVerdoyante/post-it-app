<Window x:Class="post_it_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        WindowState="Maximized"
        AllowsTransparency="True"
        BorderBrush="Aquamarine"
        BorderThickness="3"
        WindowStyle="None">
    <Window.Background>
        <SolidColorBrush Opacity="0.5" Color="White"/>
    </Window.Background>
    <StackPanel Orientation="Vertical" Margin="10">
        <WrapPanel Margin="100" Name="wpPostIts" HorizontalAlignment="Center" Orientation="Horizontal">
            
        </WrapPanel>
          

        <Button x:Name="bt_add" Click="Add_new_postit" Content="Add Post-it"></Button>
    </StackPanel>
</Window>
